{
  "name": "launchradar-worker",
  "private": true,
  "version": "1.0.0",
  "description": "LaunchRadar research API as a Cloudflare Worker (free plan, always on).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "wrangler types --include-env=false && tsc --noEmit",
    "test": "wrangler types --include-env=false && vitest run",
    "types": "wrangler types --include-env=false"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261007.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.148.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true
  }
}
