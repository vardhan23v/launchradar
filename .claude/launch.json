{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd worker && npx wrangler dev --port 8787"],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "API_URL=http://127.0.0.1:8787 npx next dev -p 3000"],
      "port": 3000
    }
  ]
}
